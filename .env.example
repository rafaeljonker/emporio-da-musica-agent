# ANTHROPIC_API_KEY=
# GEMMA_MODEL=
# GEMINI_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# DATABASE_URL=  (local: see LOCAL_DATABASE_URL in the Makefile; `make db` starts it)
