# LLM_PROVIDER=
# VLLM_BASE_URL=
# VLLM_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMMA_MODEL=
# GEMINI_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# DATABASE_URL=  (local: see LOCAL_DATABASE_URL in the Makefile; `make db` starts it)
# DEMO_EMAIL=
# DEMO_PASSWORD=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_SALT=
# `make langfuse-keys` also writes SALT, ENCRYPTION_KEY, NEXTAUTH_SECRET, CLICKHOUSE_PASSWORD,
# MINIO_ROOT_PASSWORD, REDIS_AUTH and LANGFUSE_INIT_* (self-hosted stack only).
# STORE_TODAY=
# EMPORIO_MCP_CUSTOMER_ID=  (make mcp only; unset = anonymous)
# SESSION_SECRET=  (32+ chars; `make web-keys` writes it when absent)
# SESSION_HTTPS_ONLY=  (default true; false for http://localhost)
# EMPORIO_FAKE_MODEL=
# EMPORIO_FAKE_WARM_SECONDS=
# EMPORIO_FAKE_WARM_MODE=
# WARM_EXPECTED_SECONDS_GPU=
# WARM_EXPECTED_SECONDS_LOCAL=
# WARM_READY_TTL_SECONDS=  (default 300; a READY older than this is probed again on login)
# USD_BRL=
# Phase 6 deploy (names only):
# RAILWAY_DATABASE_URL=
# CLOUD_LANGFUSE_PUBLIC_KEY=
# CLOUD_LANGFUSE_SECRET_KEY=
# RATE_LIMIT_MULTIPLIER=
# DB_POOL_MAX=  (default 4; the load-test app sets 20)
# GPU_USD_PER_HOUR=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# HF_TOKEN=  (only if a weights repo is gated; both are public today)
# EMPORIO_GPU=  (make deploy-llm LLM_GPU=H100|L40S)
# EMPORIO_WEIGHTS=  (make deploy-llm LLM_WEIGHTS=fp8|bf16)
# EMPORIO_HF_VOLUME=  (HF-cache Volume name; default huggingface-cache)
