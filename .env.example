# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_SALT=
# `make langfuse-keys` also writes SALT, ENCRYPTION_KEY, NEXTAUTH_SECRET, CLICKHOUSE_PASSWORD,
# MINIO_ROOT_PASSWORD, REDIS_AUTH and LANGFUSE_INIT_* (self-hosted stack only).
# STORE_TODAY=
# EMPORIO_MCP_CUSTOMER_ID=  (make mcp only; unset = anonymous)
# SESSION_SECRET=  (32+ chars; `make web-keys` writes it when absent)
# SESSION_HTTPS_ONLY=  (default true; false for http://localhost)
# EMPORIO_FAKE_MODEL=
# EMPORIO_FAKE_WARM_SECONDS=
# EMPORIO_FAKE_WARM_MODE=
